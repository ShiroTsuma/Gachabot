@page "/"
@inject IContentManagementStore ContentStore
@inject ISourceOperations SourceOperations

<PageTitle>Dashboard · Schmidley</PageTitle>

<section class="page-heading">
    <div>
        <h1>Dashboard</h1>
    </div>
    <a class="button button-primary" href="/content/new">New post</a>
</section>

@if (_metrics is null)
{
    <p class="loading">Loading dashboard…</p>
}
else
{
    <section class="home-dashboard-grid">
        <aside class="home-schmidley-panel">
            <img src="images/schmidley.png" alt="Schmidley" />
        </aside>
        <div class="home-dashboard-content">
            <section class="metric-grid" aria-label="Content state">
                <a class="metric-card signal" href="/content?status=Active" aria-label="View active posts">
                    <span>Active</span>
                    <strong>@_metrics.Active</strong>
                    <small>Active posts</small>
                </a>
                <a class="metric-card" href="/events" aria-label="View scheduled events">
                    <span>Scheduled</span>
                    <strong>@_metrics.Scheduled</strong>
                    <small>Upcoming deliveries</small>
                </a>
                <a class="metric-card warning" href="/content?status=Draft" aria-label="View posts awaiting review">
                    <span>Review</span>
                    <strong>@_metrics.AwaitingReview</strong>
                    <small>Awaiting review</small>
                </a>
                <a class="metric-card" href="/archive" aria-label="View archive">
                    <span>Archive</span>
                    <strong>@_metrics.Archived</strong>
                    <small>Archived posts</small>
                </a>
            </section>

            <section class="last-checked" aria-label="Source checks">
                <span>Last checked</span>
                @if (_lastCheckedUtc is { } checkedAt)
                {
                    <time datetime="@checkedAt.ToString("O")" data-relative-time>@checkedAt.ToUniversalTime().ToString("dd MMM yyyy, HH:mm 'UTC'")</time>
                }
                else
                {
                    <span>Not checked yet</span>
                }
                <a href="/sources">Sources</a>
            </section>
        </div>
    </section>
}

@code {
    private DashboardMetrics? _metrics;
    private DateTimeOffset? _lastCheckedUtc;

    protected override async Task OnInitializedAsync()
    {
        _metrics = await ContentStore.GetMetricsAsync(CancellationToken.None);
        var statuses = await SourceOperations.GetStatusesAsync(CancellationToken.None);
        _lastCheckedUtc = statuses.Select(source => source.LastAttemptUtc).Max();
    }

}
