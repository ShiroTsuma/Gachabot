@page "/sources"
@inject ISourceOperations SourceOperations

<PageTitle>Sources · Schmidley</PageTitle>

<section class="page-heading compact">
    <div>
        <h1>Sources</h1>
        <p class="lede">Import status for each source.</p>
    </div>
    <button class="button button-primary" @onclick="RunAllNowAsync" disabled="@(_runningSource is not null)">
        @(_runningSource == AllSourcesKey ? "Refreshing…" : "Refresh all")
    </button>
</section>

@if (_lastRun is not null)
{
    <section class="run-summary" aria-live="polite">
        @foreach (var result in _lastRun)
        {
            <span class="@(result.Succeeded ? "run-ok" : "run-failed")">
                @SourceLabel(result.Key): @(result.Succeeded ? ResultLabel(result.Result) : result.FailureMessage)
            </span>
        }
    </section>
}

@if (_statuses is null)
{
    <p class="loading">Checking sources…</p>
}
else
{
    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Trust</th>
                    <th>Status</th>
                    <th>Last import</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var source in _statuses)
                {
                    <tr>
                        <td>
                            <a class="content-title-link" href="@ExtractedContentUrl(source.Key)"><strong>@SourceLabel(source.Key)</strong></a>
                            <small class="source-key">@source.Key</small>
                        </td>
                        <td>@TrustLabel(source.Trust)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(source.LastFailureMessage))
                            {
                                <span class="health-dot failed" aria-hidden="true"></span>
                                <span title="@source.LastFailureMessage">Failed @FormatInstant(source.LastAttemptUtc)</span>
                            }
                            else if (!source.HasCompletedBaseline)
                            {
                                <span class="health-dot pending" aria-hidden="true"></span>
                                <span>Waiting for first import</span>
                            }
                            else
                            {
                                <span class="health-dot ok" aria-hidden="true"></span>
                                <span>OK</span>
                            }
                        </td>
                        <td><time>@FormatInstant(source.LastSuccessfulRunUtc)</time></td>
                        <td>
                            <div class="row-actions">
                                <button class="button button-quiet button-small"
                                        @onclick="() => RunSourceNowAsync(source.Key)"
                                        disabled="@(_runningSource is not null)">
                                    @(_runningSource == source.Key ? "Refreshing…" : "Refresh")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<SourceStatus>? _statuses;
    private IReadOnlyList<SourceRunResult>? _lastRun;
    private const string AllSourcesKey = "*";
    private string? _runningSource;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task RunAllNowAsync()
    {
        _runningSource = AllSourcesKey;
        try
        {
            _lastRun = await SourceOperations.RunAllAsync(CancellationToken.None);
            await ReloadAsync();
        }
        finally
        {
            _runningSource = null;
        }
    }

    private async Task RunSourceNowAsync(string sourceKey)
    {
        _runningSource = sourceKey;
        try
        {
            _lastRun = [await SourceOperations.RunAsync(sourceKey, CancellationToken.None)];
            await ReloadAsync();
        }
        finally
        {
            _runningSource = null;
        }
    }

    private async Task ReloadAsync() =>
        _statuses = await SourceOperations.GetStatusesAsync(CancellationToken.None);

    private static string TrustLabel(SourceTrust trust) => trust switch
    {
        SourceTrust.Official => "Official",
        SourceTrust.Trusted => "Trusted",
        SourceTrust.ReviewRequired => "Needs review",
        SourceTrust.Disabled => "Disabled",
        _ => trust.ToString(),
    };

    internal static string SourceLabel(string key) => key switch
    {
        "official-wuthering-waves" => "Wuthering Waves · Official",
        "official-neverness-to-everness" => "Neverness to Everness · Official",
        "game8-wuthering-waves-redeem-codes" => "Wuthering Waves · Game8 Codes",
        "game8-neverness-to-everness-redeem-codes" => "NTE · Game8 Codes",
        "wuwatracker-wuthering-waves-events" => "Wuthering Waves · WuWa Tracker Events",
        "game8-neverness-to-everness-events" => "NTE · Game8 Events",
        _ => key,
    };

    private static string ExtractedContentUrl(string sourceKey)
    {
        var destination = sourceKey is "wuwatracker-wuthering-waves-events" or "game8-neverness-to-everness-events"
            ? "/events"
            : "/content";
        return $"{destination}?source={Uri.EscapeDataString(sourceKey)}";
    }

    private static string FormatInstant(DateTimeOffset? value) => value.HasValue
        ? value.Value.ToLocalTime().ToString("dd.MM.yyyy · HH:mm")
        : "—";

    private static string ResultLabel(IngestionResult? result) => result is null
        ? "OK"
        : $"{result.Seen} seen, {result.Created} new, {result.Updated} changed";
}
