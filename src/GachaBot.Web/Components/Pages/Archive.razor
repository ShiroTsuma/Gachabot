@page "/archive"
@inject IContentManagementStore ContentStore

<PageTitle>Archive · Schmidley</PageTitle>

<section class="page-heading compact">
    <div>
        <h1>Archive</h1>
        <p class="lede">Browse expired, archived and replaced posts.</p>
    </div>
</section>

@if (_items is null)
{
    <p class="loading">Loading archive…</p>
}
else if (_items.Count == 0)
{
    <section class="empty-state">
        <h2>The archive is still empty.</h2>
    </section>
}
else
{
    <div class="archive-stack">
        @foreach (var item in _items)
        {
            <article>
                <span class="game-code">@(item.Game == GameKey.WutheringWaves ? "WUWA" : "NTE")</span>
                <div>
                    <h2><a class="content-title-link" href="@($"/content/{item.Id}")">@item.Title</a></h2>
                    <p>@item.Kind · @item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                </div>
                <div class="archive-actions">
                    <a href="@($"/content/{item.Id}")">View preview →</a>
                    @if (item.SourceUrl is not null)
                    {
                        <a href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">Source ↗</a>
                    }
                </div>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<ContentListItem>? _items;

    protected override async Task OnInitializedAsync()
    {
        _items = await ContentStore.ListAsync(ContentStatus.Archived, null, CancellationToken.None);
    }
}
