@page "/guilds"
@inject IGuildDestinationStore Destinations

<PageTitle>Guilds · Schmidley</PageTitle>

<section class="page-heading compact">
    <div>
        <h1>Guilds</h1>
        <p class="lede">Manage the channels, games and reminders for each Discord server.</p>
    </div>
</section>

@if (_destinations is null)
{
    <p class="loading">Reading guild configurations…</p>
}
else if (_destinations.Count == 0)
{
    <section class="empty-state">
        <h2>The bot has not been configured in any server yet.</h2>
        <p>A server administrator can run <code>/gachabot-configure</code> and select a publication channel.</p>
    </section>
}
else
{
    <section class="guild-grid" aria-label="Configured guilds">
        @foreach (var destination in _destinations)
        {
            <article class="guild-card @(destination.IsEnabled ? "" : "paused")">
                <header>
                    <div>
                        <p class="eyebrow">GUILD @destination.GuildId</p>
                        <h2>@DisplayGuildName(destination)</h2>
                    </div>
                    <span class="guild-state">@(destination.IsEnabled ? "ACTIVE" : "PAUSED")</span>
                </header>
                <dl>
                    <div>
                        <dt>Channel</dt>
                        <dd><a href="@ChannelUrl(destination)" target="_blank" rel="noopener noreferrer">#@DisplayChannelName(destination) ↗</a></dd>
                    </div>
                    <div>
                        <dt>Last change</dt>
                        <dd>@destination.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy · HH:mm")</dd>
                    </div>
                </dl>
                <div class="guild-topics" aria-label="Followed games">
                    @foreach (var game in destination.Games.OrderBy(game => game))
                    {
                        <span>@GameLabel(game)</span>
                    }
                </div>
                <dl class="guild-event-timing">
                    <div><dt>Event start</dt><dd>@OffsetLabel(destination.EventStartOffsetHours)</dd></div>
                    <div><dt>End reminder</dt><dd>@OffsetLabel(destination.EventEndOffsetHours)</dd></div>
                    <div><dt>Post cleanup</dt><dd>@(destination.DeleteObsoleteMessages ? "enabled" : "off")</dd></div>
                </dl>
                <a class="guild-history-link" href="@($"/guilds/{destination.GuildId}")">View queue and history →</a>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyList<GuildDestination>? _destinations;

    protected override async Task OnInitializedAsync() =>
        _destinations = await Destinations.ListAsync(CancellationToken.None);

    private static string DisplayGuildName(GuildDestination destination) =>
        string.IsNullOrWhiteSpace(destination.GuildName) ? $"Guild {destination.GuildId}" : destination.GuildName;

    private static string DisplayChannelName(GuildDestination destination) =>
        string.IsNullOrWhiteSpace(destination.ChannelName) ? destination.ChannelId.ToString() : destination.ChannelName;

    private static string ChannelUrl(GuildDestination destination) =>
        $"https://discord.com/channels/{destination.GuildId}/{destination.ChannelId}";

    private static string GameLabel(GameKey game) => game == GameKey.WutheringWaves
        ? "Wuthering Waves"
        : "Neverness to Everness";

    private static string OffsetLabel(double offsetHours) => offsetHours < 0
        ? "disabled"
        : offsetHours == 0
        ? "at the event time"
        : $"{offsetHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} h earlier";
}
