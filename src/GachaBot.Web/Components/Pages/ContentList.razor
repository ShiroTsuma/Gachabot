@page "/content"
@inject IContentManagementStore ContentStore

<PageTitle>Content · Schmidley</PageTitle>

<section class="page-heading compact">
    <div>
        <h1>Content</h1>
        <p class="lede">Announcements, updates and redeem codes. See Events for the calendar.</p>
    </div>
    <a class="button button-primary" href="/content/new">+ New post</a>
</section>

@if (_items is null)
{
    <p class="loading">Loading content…</p>
}
else
{
    <form class="content-filters" method="get" aria-label="Content filters">
        <div>
            <label for="content-game">Game</label>
            <select id="content-game" name="game" value="@Game">
                <option value="">All games</option>
                <option value="WutheringWaves">Wuthering Waves</option>
                <option value="NevernessToEverness">Neverness to Everness</option>
            </select>
        </div>
        <div>
            <label for="content-kind">Type</label>
            <select id="content-kind" name="kind" value="@Kind">
                <option value="">All types</option>
                @foreach (var kind in Enum.GetValues<ContentKind>().Where(kind => kind != ContentKind.Event))
                {
                    <option value="@kind">@kind</option>
                }
            </select>
        </div>
        <div>
            <label for="content-status">Publication state</label>
            <select id="content-status" name="status" value="@Status">
                <option value="">Any state</option>
                @foreach (var status in Enum.GetValues<ContentStatus>())
                {
                    <option value="@status">@StatusLabel(status)</option>
                }
            </select>
        </div>
        <div>
            <label for="content-source">Source</label>
            <select id="content-source" name="source" value="@Source">
                <option value="">All sources</option>
                @foreach (var sourceKey in SourceKeys)
                {
                    <option value="@sourceKey">@sourceKey</option>
                }
            </select>
        </div>
        <div class="content-search">
            <label for="content-search">Search</label>
            <input id="content-search" name="search" value="@Search" placeholder="Title or source" />
        </div>
        <input type="hidden" name="sort" value="@EffectiveSort" />
        <input type="hidden" name="direction" value="@EffectiveDirection" />
        <div class="content-filter-actions">
            <button class="button button-primary" type="submit">Filter</button>
            @if (HasFilters)
            {
                <a class="button button-quiet" href="/content">Clear</a>
            }
        </div>
    </form>

    <p class="filter-summary" aria-live="polite">@VisibleItems.Count results in the message index.</p>

    @if (VisibleItems.Count == 0)
    {
        <section class="empty-state">
                <h2>No messages match the selected filters.</h2>
            <a href="/content">Clear filters →</a>
        </section>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th aria-sort="@AriaSort("game")"><a class="sort-link" href="@SortUrl("game")">Game / type @SortMark("game")</a></th>
                        <th aria-sort="@AriaSort("title")"><a class="sort-link" href="@SortUrl("title")">Title @SortMark("title")</a></th>
                        <th aria-sort="@AriaSort("status")"><a class="sort-link" href="@SortUrl("status")">Status @SortMark("status")</a></th>
                        <th aria-sort="@AriaSort("source-date")"><a class="sort-link" href="@SortUrl("source-date")">Source date @SortMark("source-date")</a></th>
                        <th aria-sort="@AriaSort("updated")"><a class="sort-link" href="@SortUrl("updated")">Updated @SortMark("updated")</a></th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in SortedItems())
                    {
                        <tr>
                            <td><span class="game-code">@GameCode(item.Game)</span><small>@item.Kind</small></td>
                            <td>
                                <a class="content-title-link" href="/content/@item.Id"><strong>@item.Title</strong></a>
                                <small class="source-key">@item.SourceKey</small>
                                @if (item.SourceUrl is not null)
                                {
                                    <a class="source-link" href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">source ↗</a>
                                }
                            </td>
                            <td>
                                <span class="status-chip status-@item.Status.ToString().ToLowerInvariant()">@StatusLabel(item.Status)</span>
                                @if (item.ArchiveReason is not null)
                                {
                                    <small>@ArchiveReasonLabel(item.ArchiveReason.Value)</small>
                                }
                            </td>
                            <td><time>@(item.SourcePublishedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")</time></td>
                            <td><time>@item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM · HH:mm")</time></td>
                            <td>
                                <div class="row-actions">
                                    @if (item.AwaitingReview)
                                    {
                                        <button class="text-button approve" @onclick="() => ApproveAsync(item.Id)">Approve & publish</button>
                                    }
                                    @if (item.Status != ContentStatus.Archived)
                                    {
                                        <button class="text-button danger" @onclick="() => ArchiveAsync(item.Id)">Archive</button>
                                        <button class="text-button" @onclick="() => RepublishAsync(item.Id)">Republish</button>
                                    }
                                    else
                                    {
                                        <button class="text-button approve" @onclick="() => RestoreAsync(item.Id)">Restore</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    [SupplyParameterFromQuery(Name = "game")]
    public string? Game { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    public string? Kind { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "direction")]
    public string? Direction { get; set; }

    private IReadOnlyList<ContentListItem>? _items;

    private IReadOnlyList<ContentListItem> VisibleItems => (_items ?? [])
        .Where(item => item.Kind != ContentKind.Event)
        .Where(item => string.IsNullOrWhiteSpace(Source) || string.Equals(item.SourceKey, Source, StringComparison.Ordinal))
        .Where(item => string.IsNullOrWhiteSpace(Game) || string.Equals(item.Game.ToString(), Game, StringComparison.OrdinalIgnoreCase))
        .Where(item => string.IsNullOrWhiteSpace(Kind) || string.Equals(item.Kind.ToString(), Kind, StringComparison.OrdinalIgnoreCase))
        .Where(item => string.IsNullOrWhiteSpace(Status) || string.Equals(item.Status.ToString(), Status, StringComparison.OrdinalIgnoreCase))
        .Where(item => string.IsNullOrWhiteSpace(Search) ||
            item.Title.Contains(Search, StringComparison.OrdinalIgnoreCase) ||
            item.SourceKey.Contains(Search, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private IReadOnlyList<string> SourceKeys => (_items ?? [])
        .Where(item => item.Kind != ContentKind.Event)
        .Select(item => item.SourceKey)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private bool HasFilters => !string.IsNullOrWhiteSpace(Source) ||
        !string.IsNullOrWhiteSpace(Game) ||
        !string.IsNullOrWhiteSpace(Kind) ||
        !string.IsNullOrWhiteSpace(Status) ||
        !string.IsNullOrWhiteSpace(Search);

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ArchiveAsync(Guid id)
    {
        await ContentStore.ArchiveAsync(id, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task RestoreAsync(Guid id)
    {
        await ContentStore.RestoreAsync(id, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task RepublishAsync(Guid id)
    {
        await ContentStore.RepublishAsync(id, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ApproveAsync(Guid id)
    {
        await ContentStore.ApproveAsync(id, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ReloadAsync() =>
        _items = await ContentStore.ListAsync(null, null, CancellationToken.None);

    private static string GameCode(GameKey game) => game == GameKey.WutheringWaves ? "WUWA" : "NTE";

    private IEnumerable<ContentListItem> SortedItems()
    {
        var ascending = string.Equals(EffectiveDirection, "asc", StringComparison.OrdinalIgnoreCase);
        var items = VisibleItems;
        if (string.Equals(EffectiveSort, "source-date", StringComparison.OrdinalIgnoreCase))
        {
            return ascending
                ? items.OrderBy(item => item.SourcePublishedAtUtc is null)
                    .ThenBy(item => item.SourcePublishedAtUtc)
                    .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(item => item.SourcePublishedAtUtc is null)
                    .ThenByDescending(item => item.SourcePublishedAtUtc)
                    .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase);
        }

        Func<ContentListItem, object> selector = EffectiveSort.ToLowerInvariant() switch
        {
            "game" => item => $"{item.Game}:{item.Kind}",
            "title" => item => item.Title,
            "status" => item => item.Status,
            _ => item => item.UpdatedAtUtc,
        };
        return ascending
            ? items.OrderBy(selector).ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            : items.OrderByDescending(selector).ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase);
    }

    private string SortUrl(string column)
    {
        var nextDirection = string.Equals(EffectiveSort, column, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(EffectiveDirection, "asc", StringComparison.OrdinalIgnoreCase)
                ? "desc"
                : "asc";
        return "/content?" + string.Join('&', new[]
        {
            $"sort={Uri.EscapeDataString(column)}",
            $"direction={Uri.EscapeDataString(nextDirection)}",
            QueryPart("source", Source),
            QueryPart("game", Game),
            QueryPart("kind", Kind),
            QueryPart("status", Status),
            QueryPart("search", Search),
        }.Where(value => value is not null));
    }

    private static string? QueryPart(string key, string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : $"{key}={Uri.EscapeDataString(value)}";

    private string AriaSort(string column) =>
        !string.Equals(EffectiveSort, column, StringComparison.OrdinalIgnoreCase)
            ? "none"
            : string.Equals(EffectiveDirection, "asc", StringComparison.OrdinalIgnoreCase)
                ? "ascending"
                : "descending";

    private string SortMark(string column) =>
        !string.Equals(EffectiveSort, column, StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : string.Equals(EffectiveDirection, "asc", StringComparison.OrdinalIgnoreCase) ? "↑" : "↓";

    private string EffectiveSort => string.IsNullOrWhiteSpace(Sort) ? "updated" : Sort;

    private string EffectiveDirection => string.Equals(Direction, "asc", StringComparison.OrdinalIgnoreCase)
        ? "asc"
        : "desc";

    private static string StatusLabel(ContentStatus status) => status switch
    {
        ContentStatus.Draft => "Draft",
        ContentStatus.Active => "Active",
        ContentStatus.Scheduled => "Scheduled",
        ContentStatus.Published => "Published",
        ContentStatus.Archived => "Archived",
        _ => status.ToString(),
    };

    private static string ArchiveReasonLabel(ArchiveReason reason) => reason switch
    {
        ArchiveReason.Manual => "Manual",
        ArchiveReason.Expired => "Expired",
        ArchiveReason.Retention => "Retention policy",
        ArchiveReason.Superseded => "Superseded",
        _ => reason.ToString(),
    };
}
