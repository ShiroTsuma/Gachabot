        "PublishedAtSelector": ".date",
        "PublishedAtFormat": "yyyy-MM-dd",
        "DetailPublishedAtSelector": ".articleDate",
        "DetailPublishedAtFormat": "yyyy.MM.dd",
        "DetailContentSelector": ".articleContent",
